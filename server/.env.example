# Conexão com o PostgreSQL do Supabase (Project Settings → Database → Connection string)
# Prefira a string com o pooler (porta 6543) para o Prisma.
DATABASE_URL="postgresql://postgres.xxxx:password@aws-0-sa-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"

# Chave de API do TMDb (https://developer.themoviedb.org) — usada no catálogo de filmes
TMDB_API_KEY=""

# Segredo usado para assinar os tokens JWT de autenticação
JWT_SECRET="troque-por-um-segredo-longo-e-aleatorio"

# Porta do servidor NestJS
PORT=3000
